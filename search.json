---
layout: null
permalink: /search.json
---
[
  {% assign posts = site.posts | where_exp: "p", "p.draft != true" %}
  {% for p in posts %}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "date": "{{ p.date | date: "%Y-%m-%d" }}",
    "categories": {{ p.categories | jsonify }},
    "tags": {{ p.tags | default: empty | jsonify }},
    "excerpt": {{ p.excerpt | strip_html | strip_newlines | truncate: 200 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
